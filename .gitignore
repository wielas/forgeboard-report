.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
dist/
# Agent scratch: PR bodies, chunk contracts, codex transcripts, metadata.
# This used to read `.git/PR_BODY.md`, a pattern that can never match anything —
# git does not track paths under .git/, and both lanes are forbidden from
# writing there anyway (sandbox denial; .git is a file in a linked worktree).
.forge/
# Dispatcher-created worktrees live INSIDE the repo (<repo>/.worktrees/<task-id>)
# and git does not ignore them on its own. Without this line every linked
# worktree is untracked content in the parent checkout, which a `git add -A`
# inside a lane will happily stage. Measured 2026-07-28.
.worktrees/
